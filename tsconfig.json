{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Basic Options */
    "lib": ["ES2022"],
    // "baseUrl": "./",
    "target": "ES2022",
    "module": "ES2022",
    "types": ["bun", "node"],
    "paths": {
      "~encore/*": ["./encore.gen/*"],
      "@/*": ["./src/*"]
    },    

    /* Workspace Settings */
    "composite": true,

    /* Strict Type-Checking Options */
    "strict": true,
    /* Toda função deve retornar em todos os caminhos e switches de uniões
       precisam ser exaustivos — sem retorno implícito `undefined`. */
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Module Resolution Options */
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "sourceMap": true,

    "declaration": true,

    /* Advanced Options */
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
