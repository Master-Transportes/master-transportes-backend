{
  "name": "encore-ts-starter",
  "private": true,
  "version": "0.0.1",
  "description": "Encore Typescript Starter",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d && npx drizzle-kit migrate && npm run seed && npx encore run",
    "start": "npx encore run",
    "seed": "npx tsx drizzle/init/area/areas-init.ts && npx tsx drizzle/init/user/index.ts",
    "test": "encore exec -- bun test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.3.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.39",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "destr": "^2.0.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "encore.dev": "^1.57.11",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  }
}
