NODE_ENV=development

JWT_SECRET=change-me-to-a-secure-random-key

POSTGRES_DB=master_transportes
POSTGRES_USER=mt_user
POSTGRES_PASSWORD=change-me-to-a-secure-password
DATABASE_URL=postgresql://mt_user:change-me-to-a-secure-password@localhost:5432/master_transportes

REDIS_STATE_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

RABBITMQ_USER=mt_user
RABBITMQ_PASSWORD=change-me-to-a-secure-password
RABBITMQ_URL=amqp://mt_user:change-me-to-a-secure-password@localhost:5672

ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_KEY_SANDBOX='change-me-to-your-asaas-api-key'
ASAAS_WEBHOOK_TOKEN=change-me-to-a-secure-token-at-least-32-chars