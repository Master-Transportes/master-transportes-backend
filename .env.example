NODE_ENV=development

# Fonte única de configuração local: este .env (não usamos Encore secrets).
# Gere segredos NOVOS e distintos (>= 32 caracteres). Nunca reutilize valores antigos.
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-another-new-random-secret-at-least-32-chars

POSTGRES_DB=master_transportes
POSTGRES_USER=mt_user
POSTGRES_PASSWORD=change-me-to-a-secure-password
DATABASE_URL=postgresql://mt_user:change-me-to-a-secure-password@localhost:5432/master_transportes

REDIS_STATE_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
